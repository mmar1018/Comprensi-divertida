<rect x="260" y="120" width="55" height="50" fill="#b9e4f5"/>
<text x="130" y="95" font-size="25" fill="#8054b5" font-weight="bold">ESCOLA</text>
</svg>`,

dog: `
<svg viewBox="0 0 400 230">
