
<!DOCTYPE html>
<html lang="ca">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JUGUEM AMB LES PARAULES!</title>

<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  background: #faf6ff;
  color: #30243d;
  font-family: Arial, Helvetica, sans-serif;
}

header {
  background: #8054b5;
  color: white;
  text-align: center;
  padding: 25px 10px;
}

h1 { font-size: 30px; }

main {
  max-width: 800px;
  margin: 20px auto;
  padding: 15px;
}

.card {
  background: white;
  padding: 22px;
  border-radius: 22px;
  box-shadow: 0 4px 15px #0001;
}

.info {
  display: flex;
  justify-content: space-between;
  font-weight: bold;
  flex-wrap: wrap;
}

.progress {
  height: 12px;
  background: #eadff4;
  border-radius: 20px;
  margin: 15px 0;
  overflow: hidden;
}

#bar {
  height: 100%;
  width: 0;
  background: #8054b5;
}

.picture {
  background: #f3eafa;
  border-radius: 18px;
  padding: 10px;
  text-align: center;
}

.picture svg {
  width: 100%;
  max-height: 250px;
}

.sentence {
  font-size: 27px;
  font-weight: bold;
  text-align: center;
  line-height: 1.5;
  margin: 25px 5px;
}

.question {
  font-size: 21px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 18px;
}

.answers {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
}

.answer {
  background: white;
  border: 3px solid #d9c4ed;
  border-radius: 15px;
  padding: 18px;
  font-size: 20px;
  font-weight: bold;
  cursor: pointer;
}

.answer:disabled { opacity: 1; }

.answer.correct {
  background: #e3f6e9;
  border-color: green;
}

.answer.wrong {
  background: #ffe8e8;
  border-color: red;
}

#feedback {
  display: none;
  padding: 18px;
  margin-top: 20px;
  border-radius: 15px;
  font-size: 18px;
  line-height: 1.5;
}

.good { background: #e3f6e9; }
.bad { background: #ffe8e8; }

.next {
  display: block;
  margin: 20px auto;
  padding: 15px 25px;
  background: #8054b5;
  color: white;
  border: none;
  border-radius: 14px;
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
}

.next:disabled {
  opacity: .4;
}

#finish {
  display: none;
  text-align: center;
}

@media(min-width:600px) {
  .answers { grid-template-columns: 1fr 1fr; }
}
</style>
</head>

<body>

<header>
  <h1>JUGUEM AMB LES PARAULES! 💜</h1>
  <h3>LECTURA FÀCIL · LLEGEIX, PENSA I TRIA</h3>
</header>

<main>

<section class="card" id="game">

<div class="info">
  <span id="number"></span>
  <span id="score"></span>
</div>

<div class="progress">
  <div id="bar"></div>
</div>

<div class="picture" id="picture"></div>

<div class="sentence" id="sentence"></div>

<div class="question" id="question"></div>

<div class="answers" id="answers"></div>

<div id="feedback"></div>

<button class="next" id="next" disabled>
  SEGÜENT REPTE →
</button>

<p style="text-align:center">
  NO TENS PRESSA! POTS PENSAR TRANQUIL·LAMENT.
</p>

</section>

<section class="card" id="finish">
  <h2>🌟 MOLT BÉ! 🌟</h2>
  <h2 id="result"></h2>
  <p>HAS LLEGIT, HAS PENSAT I HAS APRÈS!</p>
  <button class="next" onclick="start()">TORNAR A JUGAR</button>
</section>

</main>

<script>

const activities = [

{
text:"LA SARA PORTA UN HIJAB LILA. AVUI FA GIMNÀSTICA.",
q:"QUÈ FA LA SARA?",
a:["BALLA","FA GIMNÀSTICA","DORM"],
c:1,
why:"LA FRASE DIU QUE LA SARA FA GIMNÀSTICA.",
img:"girl"
},

{
text:"EN NIL VA A L'ESCOLA AMB LA SEVA MOTXILLA.",
q:"ON VA EN NIL?",
a:["A LA PLATJA","AL PARC","A L'ESCOLA"],
c:2,
why:"EN NIL VA A L'ESCOLA AMB LA MOTXILLA.",
img:"school"
},

{
text:"EL GOS BOBI TÉ SET. BEU AIGUA DEL BOL.",
q:"QUÈ BEU EN BOBI?",
a:["AIGUA","SOPA","LLET"],
c:0,
why:"QUAN TENIM SET, BEVEM AIGUA.",
img:"dog"
},

{
text:"LA MARE, EL PARE I LA INA SOPEN JUNTS.",
q:"AMB QUI SOPA LA INA?",
a:["AMB LA FAMÍLIA","AMB EL GOS","SOLA"],
c:0,
why:"LA MARE, EL PARE I LA INA FORMEN UNA FAMÍLIA.",
img:"family"
},

{
text:"FA FRED. L'AVI PREPARA UNA SOPA CALENTA.",
q:"PER QUÈ PREPARA SOPA CALENTA?",
a:["PER TENIR CALOR","PER NEDAR","PER JUGAR"],
c:0,
why:"UNA SOPA CALENTA ENS AJUDA A ESCALFAR-NOS.",
img:"soup"
},

{
text:"LA SAMIRA TÉ UNA FALDILLA LILA I UNA PILOTA.",
q:"DE QUIN COLOR ÉS LA FALDILLA?",
a:["VERDA","LILA","GROGA"],
c:1,
why:"LA FRASE DIU QUE LA FALDILLA ÉS LILA.",
img:"purple"
},

{
text:"EN PAU MENJA UNA POMA PER ESMORZAR.",
q:"QUÈ MENJA EN PAU?",
a:["UNA POMA","UN ENTREPÀ","UNA SOPA"],
c:0,
why:"EN PAU MENJA UNA POMA.",
img:"apple"
},

{
text:"LA LAIA CAU A TERRA. EL GOS S'ACOSTA I LI FA COMPANYIA.",
q:"COM ES POT SENTIR LA LAIA?",
a:["ACOMPANYADA","MULLADA","ADORMIDA"],
c:0,
why:"EL GOS LI FA COMPANYIA. PER AIXÒ, LA LAIA ES POT SENTIR ACOMPANYADA.",
img:"dog"
},

{
text:"LA CLASSE REGA LES PLANTES DE L'ESCOLA.",
q:"PER QUÈ REGUEN LES PLANTES?",
a:["PERQUÈ TINGUIN AIGUA","PERQUÈ TINGUIN SABATES","PERQUÈ FACIN SOROLL"],
c:0,
why:"LES PLANTES NECESSITEN AIGUA PER CRÉIXER.",
img:"plant"
},

{
text:"DESPRÉS DE GIMNÀSTICA, LA SARA ESTÀ SUADA I TÉ SET.",
q:"QUÈ LI ANIRÀ BÉ ARA?",
a:["UN GOT D'AIGUA","UNA BUFANDA","UNA PILOTA"],
c:0,
why:"DESPRÉS DE FER EXERCICI, BEURE AIGUA ÉS UNA BONA IDEA.",
img:"girl"
}

];

// IL·LUSTRACIONS SVG INCORPORADES

function illustration(type) {

let drawings = {

