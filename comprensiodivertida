<path d="M200 70 Q125 25 105 110 Q90 205 185 215 Q205 220 220 210 Q310 235 320 130 Q325 40 240 65 Q215 75 200 70Z" fill="#e75d62"/>
<path d="M200 70 Q205 30 230 20" fill="none" stroke="#6b4932" stroke-width="9"/>
<ellipse cx="250" cy="35" rx="28" ry="12" fill="#6eaa75"/>
</svg>`,

plant: `
<svg viewBox="0 0 400 230">
<path d="M200 200 Q180 110 200 70" stroke="#4e8a4d" stroke-width="9" fill="none"/>
<path d="M200 135 Q110 50 95 120 Q125 180 200 150 Q280 50 305 120 Q275 180 200 150" fill="#6eaa75"/>
<rect x="135" y="185" width="130" height="40" rx="8" fill="#bd7952"/>
<text x="35" y="80" font-size="35">💧</text>
</svg>`
};

return drawings[type] || drawings.girl;
}

let index = 0;
let score = 0;
let answered = false;

function render() {

let t = activities[index];

answered = false;

document.getElementById("number").textContent =
"REPTE " + (index+1) + " DE " + activities.length;

document.getElementById("score").textContent =
"ENCERTS: " + score;

document.getElementById("bar").style.width =
(index / activities.length * 100) + "%";

document.getElementById("picture").innerHTML =
illustration(t.img);

document.getElementById("sentence").textContent = t.text;
document.getElementById("question").textContent = t.q;

document.getElementById("feedback").style.display = "none";

let box = document.getElementById("answers");
box.innerHTML = "";

t.a.forEach((answer,i) => {

let button = document.createElement("button");

button.className = "answer";
button.textContent = answer;

button.onclick = () => choose(i);

box.appendChild(button);

});

document.getElementById("next").disabled = true;
}

function choose(choice) {

if(answered) return;

answered = true;

let t = activities[index];

let buttons = document.querySelectorAll(".answer");

buttons.forEach((button,i) => {

button.disabled = true;

if(i === t.c) button.classList.add("correct");

else if(i === choice) button.classList.add("wrong");

});

let correct = choice === t.c;

if(correct) score++;

let feedback = document.getElementById("feedback");

feedback.style.display = "block";
feedback.className = correct ? "good" : "bad";

if(correct) {

feedback.innerHTML =
"<b>🌟 MOLT BÉ! ÉS CORRECTE!</b><br>" + t.why;

} else {

feedback.innerHTML =
"<b>💜 HO TORNEM A PENSAR!</b><br>" +
"LA RESPOSTA CORRECTA ÉS: <b>" +
t.a[t.c] + "</b><br>" + t.why;

}

document.getElementById("score").textContent =
"ENCERTS: " + score;

document.getElementById("next").disabled = false;

document.getElementById("next").textContent =
index === activities.length-1 ?
"VEURE RESULTAT" : "SEGÜENT REPTE →";

}

document.getElementById("next").onclick = () => {

if(index < activities.length-1) {

index++;
render();

} else {

document.getElementById("game").style.display = "none";

document.getElementById("finish").style.display = "block";

document.getElementById("result").textContent =
"HAS FET " + score + " DE " + activities.length + " ENCERTS!";

}

};

function start() {

index = 0;
score = 0;

document.getElementById("finish").style.display = "none";
document.getElementById("game").style.display = "block";

render();

}

start();

</script>
</body>
</html>
