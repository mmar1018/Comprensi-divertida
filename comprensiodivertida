<svg viewBox="0 0 400 230">
<circle cx="200" cy="65" r="32" fill="#c98762"/>
<path d="M168 65 Q170 15 210 25 Q245 35 232 80 Q200 55 168 65" fill="#7652ad"/>
<path d="M168 65 Q200 105 232 65 Q240 120 200 130 Q165 115 168 65" fill="#8d69c6"/>
<path d="M160 130 Q200 110 240 130 L270 220 H130Z" fill="#efb5d0"/>
<circle cx="188" cy="67" r="4"/>
<circle cx="212" cy="67" r="4"/>
<path d="M190 85 Q200 95 210 85" fill="none" stroke="#7b453c" stroke-width="3"/>
<text x="35" y="65" font-size="35">⭐</text>
<text x="310" y="70" font-size="35">🤸</text>
