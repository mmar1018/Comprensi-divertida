</svg>`,

soup: `
<svg viewBox="0 0 400 230">
<path d="M80 110 H320 Q300 220 200 220 Q100 220 80 110Z" fill="#8d69c6"/>
<ellipse cx="200" cy="110" rx="120" ry="25" fill="#fff0bd" stroke="#7652ad" stroke-width="5"/>
<path d="M150 90 Q135 55 155 35 M200 90 Q185 55 205 35 M250 90 Q235 55 255 35" fill="none" stroke="#e5a34d" stroke-width="6"/>
